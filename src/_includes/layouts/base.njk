<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{ description or site.description }}">
  <title>{% if pageTitle and pageTitle != site.title %}{{ pageTitle }} | {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>
  <script>
    (function () {
      var fallback = "classic";
      var choices = ["classic", "blueprint", "sage", "paper", "plain"];
      var saved = fallback;

      try {
        saved = window.localStorage.getItem("gmdf-background-choice") || fallback;
      } catch (error) {
        saved = fallback;
      }

      document.documentElement.dataset.background = choices.indexOf(saved) >= 0 ? saved : fallback;
    })();
  </script>
  <link rel="stylesheet" href="{{ rootPath or '' }}assets/css/style.css?v={{ site.assetVersion }}">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header" aria-label="Site header">
    <nav class="menu-bar" aria-label="Primary navigation">
      <a class="menu-brand" href="{{ rootPath or '' }}index.html" aria-label="{{ site.title }} home">
        <span class="pixel-mark" aria-hidden="true"></span>
        <span>{{ site.title }}</span>
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu">
        Menu
      </button>
      <ul class="menu-list" id="site-menu">
        {%- for item in site.nav %}
          <li><a href="{{ rootPath or '' }}{{ item.url }}"{% if current == item.key %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {%- endfor %}
      </ul>
      <fieldset class="background-picker" aria-label="Desktop background style">
        <legend>Background</legend>
        <button class="background-swatch background-swatch-classic" type="button" data-background-choice="classic" aria-pressed="true" title="Classic grey">
          <span class="visually-hidden">Classic grey background</span>
        </button>
        <button class="background-swatch background-swatch-blueprint" type="button" data-background-choice="blueprint" aria-pressed="false" title="Blueprint blue">
          <span class="visually-hidden">Blueprint blue background</span>
        </button>
        <button class="background-swatch background-swatch-sage" type="button" data-background-choice="sage" aria-pressed="false" title="Sage green">
          <span class="visually-hidden">Sage green background</span>
        </button>
        <button class="background-swatch background-swatch-paper" type="button" data-background-choice="paper" aria-pressed="false" title="Warm paper">
          <span class="visually-hidden">Warm paper background</span>
        </button>
        <button class="background-swatch background-swatch-plain" type="button" data-background-choice="plain" aria-pressed="false" title="Plain high contrast">
          <span class="visually-hidden">Plain high contrast background without texture</span>
        </button>
      </fieldset>
      <button class="window-reset" type="button" data-reset-windows hidden title="Reset window layout" aria-label="Reset window layout">
        Reset
      </button>
    </nav>
  </header>

  {{ content | safe }}

  <footer class="site-footer">
    <div>
      <strong>{{ site.title }}</strong>
      <p>{{ site.footerTagline }}</p>
    </div>
    <p class="footer-meta">Last interface refresh: <span data-current-year>2026</span></p>
  </footer>

  <script src="{{ rootPath or '' }}assets/js/main.js?v={{ site.assetVersion }}"></script>
  {%- if adminPage %}
    <script src="{{ rootPath or '' }}assets/js/admin.js?v={{ site.assetVersion }}"></script>
  {%- endif %}
</body>
</html>

---
layout: layouts/base.njk
pageTitle: Research Literature
current: literature
description: Research literature and reading resources for Grasping More-than-Digital Futures.
permalink: literature.html
---
<main id="main" class="page-shell">
  <section class="window page-intro">
    <div class="title-bar">
      <span class="window-box" aria-hidden="true"></span>
      <h1 class="title-text">Research Literature</h1>
      <span class="window-lines" aria-hidden="true"></span>
    </div>
    <div class="window-body">
      <p class="lead">{{ literature.intro }}</p>
    </div>
  </section>

  <section aria-labelledby="literature-title">
    <div class="section-heading">
      <p class="system-note">Reading resources</p>
      <h2 id="literature-title">Bibliography Placeholders</h2>
    </div>

    <div class="literature-stack">
      {# Edit literature categories and references in src/_data/literature.json. Verify real citations before publishing. #}
      {% for category in literature.categories %}
        <article class="window literature-category">
          <div class="title-bar">
            <span class="window-box" aria-hidden="true"></span>
            <h3 class="title-text">{{ category.title }}</h3>
            <span class="window-lines" aria-hidden="true"></span>
          </div>
          <div class="window-body">
            <ul class="bibliography-list">
              {% for item in category.items %}
                <li><strong>{{ item.author }}</strong> ({{ item.year }}). <em>{{ item.title }}</em> {{ item.source }} Note: {{ item.note }} <a href="{{ item.url }}">{{ item.linkLabel }}</a></li>
              {% endfor %}
            </ul>
          </div>
        </article>
      {% endfor %}
    </div>
  </section>
</main>

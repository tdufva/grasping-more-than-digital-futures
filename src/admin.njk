---
layout: layouts/base.njk
pageTitle: Admin Editor
current: admin
rootPath: ../
adminPage: true
description: Browser-based content editor for the Grasping More-than-Digital Futures site.
permalink: admin/index.html
---
<main id="main" class="page-shell admin-shell" data-admin-editor>
  <section class="window page-intro">
    <div class="title-bar">
      <span class="window-box" aria-hidden="true"></span>
      <h1 class="title-text">Admin Editor</h1>
      <span class="window-lines" aria-hidden="true"></span>
    </div>
    <div class="window-body">
      <p class="lead">Edit the site through ordinary form fields. Changes are kept as a private draft in this browser while you work.</p>
      <p class="system-note">To publish, the editor copies one prepared file into GitHub. GitHub Actions then updates the public site.</p>
    </div>
  </section>

  <section class="window admin-lock-window" aria-labelledby="admin-lock-title" data-admin-lock>
    <div class="title-bar">
      <span class="window-box" aria-hidden="true"></span>
      <h2 id="admin-lock-title" class="title-text">Access</h2>
      <span class="window-lines" aria-hidden="true"></span>
    </div>
    <div class="window-body">
      <form class="admin-lock-form" data-admin-login>
        <label class="admin-field">
          <span>Password</span>
          <input type="password" data-admin-password autocomplete="current-password">
        </label>
        <button class="classic-button" type="submit">Unlock Admin</button>
      </form>
      <p class="admin-status" data-admin-lock-status aria-live="polite">Enter the shared admin password to open the editor.</p>
      <p class="system-note">This is a lightweight static-site gate. GitHub still controls who can commit changes.</p>
    </div>
  </section>

  <div data-admin-content hidden>
    <section class="window admin-command-window" aria-labelledby="admin-command-title">
      <div class="title-bar">
        <span class="window-box" aria-hidden="true"></span>
        <h2 id="admin-command-title" class="title-text">Choose File</h2>
        <span class="window-lines" aria-hidden="true"></span>
      </div>
      <div class="window-body admin-command-body">
        <ol class="admin-workflow" aria-label="Publishing steps">
          <li data-admin-step="edit" aria-current="step"><span>1</span>Edit</li>
          <li data-admin-step="check"><span>2</span>Check</li>
          <li data-admin-step="github"><span>3</span>Open GitHub</li>
          <li data-admin-step="commit"><span>4</span>Commit</li>
        </ol>
        <div class="admin-tabs" role="tablist" aria-label="Editable content files">
          <button class="classic-button" type="button" data-admin-tab="site" role="tab" aria-selected="true"><span>Home</span><span class="admin-draft-mark" aria-hidden="true">*</span></button>
          <button class="classic-button" type="button" data-admin-tab="members" role="tab" aria-selected="false"><span>Members</span><span class="admin-draft-mark" aria-hidden="true">*</span></button>
          <button class="classic-button" type="button" data-admin-tab="news" role="tab" aria-selected="false"><span>News &amp; Events</span><span class="admin-draft-mark" aria-hidden="true">*</span></button>
          <button class="classic-button" type="button" data-admin-tab="research" role="tab" aria-selected="false"><span>Research</span><span class="admin-draft-mark" aria-hidden="true">*</span></button>
          <button class="classic-button" type="button" data-admin-tab="contact" role="tab" aria-selected="false"><span>Contact</span><span class="admin-draft-mark" aria-hidden="true">*</span></button>
          <button class="classic-button" type="button" data-admin-tab="companion" role="tab" aria-selected="false"><span>Pixel</span><span class="admin-draft-mark" aria-hidden="true">*</span></button>
        </div>
        <div class="admin-action-row" aria-label="File actions">
          <button class="classic-button" type="button" data-admin-action="validate">Validate</button>
          <button class="classic-button admin-primary-action" type="button" data-admin-action="github">Copy &amp; Open GitHub</button>
          <button class="classic-button" type="button" data-admin-action="copy">Copy File</button>
          <button class="classic-button" type="button" data-admin-action="download">Download Backup</button>
          <button class="classic-button" type="button" data-admin-action="restore">Restore Published</button>
          <button class="classic-button" type="button" data-admin-action="lock">Lock Admin</button>
        </div>
        <div class="admin-file-state">
          <p class="admin-status" data-admin-status aria-live="polite">Ready to edit <code>src/_data/site.json</code>.</p>
          <p class="admin-draft-status" data-admin-draft-status aria-live="polite">No browser draft for this file.</p>
        </div>
      </div>
    </section>

    <div class="admin-editor-grid">
      <section class="window admin-edit-window" aria-labelledby="admin-form-title">
        <div class="title-bar">
          <span class="window-box" aria-hidden="true"></span>
          <h2 id="admin-form-title" class="title-text" data-admin-form-title>Members Form</h2>
          <span class="window-lines" aria-hidden="true"></span>
        </div>
        <div class="window-body">
          <div data-admin-form></div>
        </div>
      </section>

      <aside class="window admin-preview-window" aria-labelledby="admin-preview-title">
        <div class="title-bar">
          <span class="window-box" aria-hidden="true"></span>
          <h2 id="admin-preview-title" class="title-text">Preview + Prepared File</h2>
          <span class="window-lines" aria-hidden="true"></span>
        </div>
        <div class="window-body">
          <section class="admin-validation-panel" aria-labelledby="admin-validation-title">
            <h3 id="admin-validation-title">Validation</h3>
            <ul class="compact-list admin-validation-list" data-admin-validation></ul>
          </section>

          <section class="admin-preview-panel" aria-labelledby="admin-live-preview-title">
            <h3 id="admin-live-preview-title">Page Preview</h3>
            <div data-admin-preview></div>
          </section>

          <label class="admin-field admin-output-field">
            <span>Prepared file</span>
            <textarea data-admin-output rows="16" readonly spellcheck="false"></textarea>
          </label>
        </div>
      </aside>
    </div>
  </div>

  <script type="application/json" id="admin-site-data">{{ site | json | safe }}</script>
  <script type="application/json" id="admin-members-data">{{ members | json | safe }}</script>
  <script type="application/json" id="admin-news-data">{{ news | json | safe }}</script>
  <script type="application/json" id="admin-research-data">{{ researchThemes | json | safe }}</script>
  <script type="application/json" id="admin-contact-data">{{ contact | json | safe }}</script>
  <script type="application/json" id="admin-companion-data">{{ companion | json | safe }}</script>
  <script type="application/json" id="admin-file-config">{
    "site": {
      "label": "Home",
      "filePath": "src/_data/site.json",
      "downloadName": "site.json",
      "editUrl": "{{ site.repository.url }}/edit/{{ site.repository.branch }}/src/_data/site.json"
    },
    "members": {
      "label": "Members",
      "filePath": "src/_data/members.json",
      "downloadName": "members.json",
      "editUrl": "{{ site.repository.url }}/edit/{{ site.repository.branch }}/src/_data/members.json"
    },
    "news": {
      "label": "News & Events",
      "filePath": "src/_data/news.json",
      "downloadName": "news.json",
      "editUrl": "{{ site.repository.url }}/edit/{{ site.repository.branch }}/src/_data/news.json"
    },
    "research": {
      "label": "Research",
      "filePath": "src/_data/researchThemes.json",
      "downloadName": "researchThemes.json",
      "editUrl": "{{ site.repository.url }}/edit/{{ site.repository.branch }}/src/_data/researchThemes.json"
    },
    "contact": {
      "label": "Contact",
      "filePath": "src/_data/contact.json",
      "downloadName": "contact.json",
      "editUrl": "{{ site.repository.url }}/edit/{{ site.repository.branch }}/src/_data/contact.json"
    },
    "companion": {
      "label": "Pixel",
      "filePath": "src/_data/companion.json",
      "downloadName": "companion.json",
      "editUrl": "{{ site.repository.url }}/edit/{{ site.repository.branch }}/src/_data/companion.json"
    }
  }</script>
</main>

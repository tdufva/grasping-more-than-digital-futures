---
layout: layouts/base.njk
pageTitle: Contact
current: contact
description: Contact and join Grasping More-than-Digital Futures, an informal interdisciplinary research collective.
permalink: contact.html
---
<main id="main" class="page-shell contact-layout">
  <section class="window page-intro">
    <div class="title-bar">
      <span class="window-box" aria-hidden="true"></span>
      <h1 class="title-text">Contact / Join Us</h1>
      <span class="window-lines" aria-hidden="true"></span>
    </div>
    <div class="window-body">
      <p class="lead">{{ contact.intro }}</p>
    </div>
  </section>

  <section class="window contact-window" aria-labelledby="invitation-title">
    <div class="title-bar">
      <span class="window-box" aria-hidden="true"></span>
      <h2 id="invitation-title" class="title-text">Invitation</h2>
      <span class="window-lines" aria-hidden="true"></span>
    </div>
    <div class="window-body">
      {% for paragraph in contact.invitationParagraphs %}
        <p>{{ paragraph }}</p>
      {% endfor %}
      <div class="contact-action-panel" data-protected-email data-ready-message="{{ contact.emailReadyMessage }}">
        <p class="system-note">Protected contact</p>
        <button class="classic-button contact-primary-button" type="button" data-email-reveal aria-expanded="false" aria-controls="protected-email-actions protected-email-status">
          {{ contact.emailActionLabel }}
        </button>
        <p class="contact-help" id="protected-email-help">{{ contact.emailHelp }}</p>
        <div class="contact-actions" id="protected-email-actions" data-email-actions aria-describedby="protected-email-help" hidden>
          <a class="classic-button small contact-email-link" data-email-open>{{ contact.emailOpenLabel }}</a>
          <button class="classic-button small" type="button" data-email-copy>{{ contact.emailCopyLabel }}</button>
        </div>
        <p class="contact-line" id="protected-email-status" aria-live="polite">
          <strong>Status:</strong> <span data-email-output>{{ contact.emailFallback }}</span>
        </p>
        <noscript>
          <p class="contact-line"><strong>Email:</strong> {{ contact.emailFallback }}</p>
        </noscript>
      </div>
    </div>
  </section>

  <aside class="window contact-window" aria-labelledby="note-title">
    <div class="title-bar">
      <span class="window-box" aria-hidden="true"></span>
      <h2 id="note-title" class="title-text">A Gentle Note</h2>
      <span class="window-lines" aria-hidden="true"></span>
    </div>
    <div class="window-body">
      <p>{{ contact.note }}</p>
      <ul class="check-list">
        {% for suggestion in contact.suggestions %}
          <li>{{ suggestion }}</li>
        {% endfor %}
      </ul>
    </div>
  </aside>
</main>

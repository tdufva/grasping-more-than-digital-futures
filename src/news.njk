---
layout: layouts/base.njk
pageTitle: News & Events
current: news
description: News, events, workshops, seminars, reading groups, calls, and announcements from Grasping More-than-Digital Futures.
permalink: news.html
---
<main id="main" class="page-shell">
  <section class="window page-intro">
    <div class="title-bar">
      <span class="window-box" aria-hidden="true"></span>
      <h1 class="title-text">News &amp; Events</h1>
      <span class="window-lines" aria-hidden="true"></span>
    </div>
    <div class="window-body">
      <p class="lead">{{ news.intro }}</p>
    </div>
  </section>

  <section aria-labelledby="news-list-title">
    <div class="section-heading with-filter">
      <div>
        <p class="system-note">Reverse chronological</p>
        <h2 id="news-list-title">Current Notices</h2>
      </div>
      <div class="filter-stack">
        <label class="filter-control" for="news-filter">
          <span>Show</span>
          <select id="news-filter" data-news-filter aria-describedby="news-filter-status">
            <option value="all">All types</option>
            {% for option in news.current | newsTypeOptions %}
              <option value="{{ option.slug }}">{{ option.label }}</option>
            {% endfor %}
          </select>
        </label>
        <p class="filter-status" id="news-filter-status" data-news-filter-status aria-live="polite">Showing all {{ news.current.length }} current notices.</p>
      </div>
    </div>

    <div class="news-list">
      {# Edit news and event items in src/_data/news.json. #}
      {% for item in news.current | sortByDateDesc %}
        <article class="window news-item" data-news-type="{{ (item.typeSlug or item.type) | slugify }}">
          <div class="title-bar">
            <span class="window-box" aria-hidden="true"></span>
            <h3 class="title-text">{{ item.title }}</h3>
            <span class="window-lines" aria-hidden="true"></span>
          </div>
          <div class="window-body">
            <p class="item-meta">
              {% if item.date | isDate %}
                <time datetime="{{ item.date }}">{{ item.date | readableDate }}</time>
              {% else %}
                <span>{{ item.date }}</span>
              {% endif %}
              · <span>{{ item.type }}</span>
            </p>
            <p>{{ item.description }}</p>
            {% if item.url %}
              <a class="text-link" href="{{ item.url }}">{{ item.linkLabel or "Link" }}</a>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </section>

  <aside class="window archive-panel" aria-labelledby="archive-title">
    <div class="title-bar">
      <span class="window-box" aria-hidden="true"></span>
      <h2 id="archive-title" class="title-text">Archive</h2>
      <span class="window-lines" aria-hidden="true"></span>
    </div>
    <div class="window-body">
      <ul class="compact-list">
        {% for item in news.archive | sortByDateDesc %}
          <li>
            {% if item.date | isDate %}
              <time datetime="{{ item.date }}">{{ item.date | readableDate }}</time>
            {% else %}
              <span>{{ item.date }}</span>
            {% endif %}
            · {{ item.description }}
          </li>
        {% endfor %}
      </ul>
    </div>
  </aside>
</main>
